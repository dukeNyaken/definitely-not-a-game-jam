ов, текстура 64).\n\nДальше вкладка 4: выбери вещь в нужный слот (после новой вещи нажми R)."],"widgets_values_named":{"text":"ВКЛАДКА 3: текст -> вещь (шлем, доспех, меч, щит, перчатки, сапоги, амулет)\n\n1. Промпт вещи — в группе 1. Обязательно: одна вещь, ВИД СТРОГО СПЕРЕДИ, симметрично, по центру, ровный светлый фон, без человека и манекена.\n • меч: вертикально, клинок вверх, рукоять внизу; размер картинки (EmptyLatentImage) 768x1344;\n • перчатка: одна, пальцами вниз, 768x1344; сапог: один, носком к зрителю (вторые получатся зеркалом);\n • остальное — 1024x1024.\n2. Вид сзади — как у персонажа (IoU ≥ 0.85).\n4. «сохранить»: name = имя вещи (helmet, sword...), kind = вещь -> папка output/char3d/item_<name>/.\n5. Лоу-поли: 0 = по умолчанию (300 треугольников, текстура 64).\n\nДальше вкладка 4: выбери вещь в нужный слот (после новой вещи нажми R)."},"color":"#432","bgcolor":"#653"}],"links":[[41,1,0,4,0,"MODEL"],[42,2,0,5,0,"CLIP"],[43,4,0,7,0,"MODEL"],[44,5,0,7,1,"CONDITIONING"],[45,5,1,7,2,"CONDITIONING"],[46,6,0,7,3,"LATENT"],[47,7,0,8,0,"LATENT"],[48,3,0,8,1,"VAE"],[49,2,0,9,0,"CLIP"],[50,3,0,9,3,"VAE"],[51,8,0,9,1,"IMAGE"],[52,4,0,10,0,"MODEL"],[53,9,0,10,1,"CONDITIONING"],[54,9,1,10,2,"CONDITIONING"],[55,9,2,10,3,"LATENT"],[56,10,0,11,0,"LATENT"],[57,3,0,11,1,"VAE"],[58,8,0,12,0,"IMAGE"],[59,13,0,14,0,"MODEL"],[60,13,1,15,0,"CLIP_VISION"],[61,12,0,15,1,"IMAGE"],[62,15,0,16,0,"CLIP_VISION_OUTPUT"],[63,14,0,18,0,"MODEL"],[64,16,0,18,1,"CONDITIONING"],[65,16,1,18,2,"CONDITIONING"],[66,17,0,18,3,"LATENT"],[67,18,0,19,0,"LATENT"],[68,13,2,19,1,"VAE"],[69,19,0,20,0,"VOXEL"],[70,8,0,21,0,"IMAGE"],[71,11,0,21,2,"IMAGE"],[72,20,0,21,1,"MESH"],[73,21,0,22,0,"FILE_3D_GLB"],[74,21,2,23,0,"STRING"],[75,8,0,24,0,"IMAGE"],[76,11,0,25,0,"IMAGE"],[77,12,0,26,0,"IMAGE"],[78,21,1,27,0,"STRING"],[79,27,0,28,0,"FILE_3D_GLB"],[80,27,2,29,0,"STRING"]],"groups":[{"id":1,"title":"Qwen-Image 2.1: модели","bounding":[405,5,300,559],"color":"#3f789e","flags":{}},{"id":2,"title":"1. Ка