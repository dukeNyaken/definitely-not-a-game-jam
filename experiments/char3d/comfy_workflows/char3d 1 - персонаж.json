ением:\n• IoU вида сзади ≥ 0.85. Если «МАЛО» — поменяй seed в KSampler группы 2 и запусти снова (остальное возьмётся из кэша).\n\n~3-4 мин, первый запуск дольше.\nQwen-Image 2.1 — только некоммерческое.\nСторож прерывает счёт на 85 °C."},"color":"#432","bgcolor":"#653"}],"links":[[38,1,0,4,0,"MODEL"],[39,2,0,5,0,"CLIP"],[40,4,0,7,0,"MODEL"],[41,5,0,7,1,"CONDITIONING"],[42,5,1,7,2,"CONDITIONING"],[43,6,0,7,3,"LATENT"],[44,7,0,8,0,"LATENT"],[45,3,0,8,1,"VAE"],[46,2,0,9,0,"CLIP"],[47,3,0,9,3,"VAE"],[48,8,0,9,1,"IMAGE"],[49,4,0,10,0,"MODEL"],[50,9,0,10,1,"CONDITIONING"],[51,9,1,10,2,"CONDITIONING"],[52,9,2,10,3,"LATENT"],[53,10,0,11,0,"LATENT"],[54,3,0,11,1,"VAE"],[55,8,0,12,0,"IMAGE"],[56,13,0,14,0,"MODEL"],[57,13,1,15,0,"CLIP_VISION"],[58,12,0,15,1,"IMAGE"],[59,15,0,16,0,"CLIP_VISION_OUTPUT"],[60,14,0,18,0,"MODEL"],[61,16,0,18,1,"CONDITIONING"],[62,16,1,18,2,"CONDITIONING"],[63,17,0,18,3,"LATENT"],[64,18,0,19,0,"LATENT"],[65,13,2,19,1,"VAE"],[66,19,0,20,0,"VOXEL"],[67,8,0,21,0,"IMAGE"],[68,11,0,21,2,"IMAGE"],[69,20,0,21,1,"MESH"],[70,21,0,22,0,"FILE_3D_GLB"],[71,21,2,23,0,"STRING"],[72,8,0,24,0,"IMAGE"],[73,11,0,25,0,"IMAGE"],[74,12,0,26,0,"IMAGE"]],"groups":[{"id":1,"title":"Qwen-Image 2.1: модели","bounding":[405,5,300,559],"color":"#3f789e","flags":{}},{"id":2,"title":"1. Картинка спереди (промпт — здесь)","bounding":[745,5,410,1544],"color":"#3f789e","flags":{}},{"id":3,"title":"2. Вид сзади (правка Qwen)","bounding":[1195,5,410,1383],"color":"#3f789e","flags":{}},{"id":4,"title":"3. Вырезка фона -> Hunyuan3D","bounding":[1645,5,432.56796875,1252],"color":"#3f789e","flags":{}},{"id":5,"title":"4. Сетка -> сохранить","bounding":[2117.56796875,5,355.3423828125,1000],"color":"#3f789e","flags":{}},{"id":6,"title":"Просмотр сырой сетки","bounding":[2512.9103515625,5,490,710],"color":"#3f789e","flags":{}}],"config":{},"extra":{"ds":{"scale":0.3,"offset":[30,120]}},"version":0.4}