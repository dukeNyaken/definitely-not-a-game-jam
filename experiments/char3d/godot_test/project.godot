; Проверочный проект конвейера персонажей. Отдельный от игры: в игре
; эксперименты не применяются (папка experiments/ закрыта .gdignore).
; Рендер как в игре — GL Compatibility. PS1-вид здесь не повторяется: его даёт игра.

config_version=5

[application]

config/name="char3d test"
run/main_scene="res://test.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=960
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
