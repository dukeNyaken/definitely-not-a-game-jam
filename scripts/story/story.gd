static func speaker(who: StringName) -> Dictionary:
	return SPEAKERS.get(who, {"name": "", "color": UiKit.TEXT})


static func kind_of(who: StringName) -> int:
	if who == &"hero":
		return ActorModel.Kind.HERO
	return int(speaker(who).get("kind", ActorModel.Kind.HERO))


static func gift(item_id: StringName) -> Dictionary:
	return GIFTS.get(item_id, {})


## Кто получил отданные вещи, по порядку жертв.
static func recipients(snapshots: Array[ItemState]) -> Array[StringName]:
	var out: Array[StringName] = []
	for s in snapshots:
		var who: StringName = gift(s.def_id).get("who", &"")
		if who != &"" and not out.has(who):
			out.append(who)
	return out


static func was_given(snapshots: Array[ItemState], item_id: StringName) -> bool:
	for s in snapshots:
		if s.def_id == item_id:
			return true
	return false


## Подпись к потоку силы: «Отданное не ослабляет: сила меча перешла в сапоги — «Режущий рывок».»
static func light_caption(victim_id: StringName, recipient_id: StringName, property_name: String) -> String:
	return LIGHT_CAPTION.format({
		"victim": GENITIVE.get(victim_id, "вещи"),
		"recipient": ITEM_NAMES.get(recipient_id, Db.item(recipient_id).display_name.to_lower()),
		"property": property_name,
	})


static func interlude_header() -> String:
	return INTERLUDE_HEADER.format({"name": speaker(&"brother")["name"]})


## Голос из дворца после дара n (с 1). Пятая реплика зависит от того, отдан ли уже перстень.
static func brother_line(n: int, snapshots: Array[ItemState]) -> String:
	if n < 1 or n > BROTHER_LINES.size():
		return ""
	if n == RING_LINE_INDEX and was_given(snapshots, &"gloves"):
		return BROTHER_RING_LINE
	return BROTHER_LINES[n - 1]


## Сольвейг — матери: «Он уже отдал меч и сапоги…». Оберег не в счёт — он у неё самой.
## Пусто, если чужим ещё ничего не отдано.
static func hearth_given_line(snapshots: Array[ItemState]) -> String:
	var names: Array[String] = []
	for s in snapshots:
		if s.def_id != &"amulet" and ITEM_NAMES.has(s.def_id):
			names.append(ITEM_NAMES[s.def_id])
	if names.is_empty():
		return ""
	return (HEARTH["gave"] as String).format({"items": list_text(names)})


## Перечисление: «меч», «меч и сапоги», «меч, сапоги и щит».
static func list_text(words: Array[String]) -> String:
	if words.size() <= 1:
		return "" if words.is_empty() else words[0]
	return "%s и %s" % [", ".join(words.slice(0, words.size() - 1)), words.back()]


## Заставка главы: [заголовок, подзаголовок].
static func chapter(key: String) -> Array:
	return CHAPTERS.get(key, ["", ""])


## Заставка дара: «Дар первый» / «Меч · Торстейн».
static func gift_chapter(ordinal: int, item_id: StringName) -> Array:
	var c: Array = CHAPTERS["gift"]
	var n: String = ORDINALS[clampi(ordinal - 1, 0, ORDINALS.size() - 1)]
	var item: String = ITEM_NAMES.get(item_id, "")
	var who: StringName = gift(item_id).get("who", &"")
	return [
		(c[0] as String).format({"n": n}),
		(c[1] as String).format({"item": item.left(1).to_upper() + item.substr(1), "name": speaker(who)["name"]}),
	]


## Вещи для монтажа в финале: первые отданные, не больше max_count.
static func finale_items(snapshots: Array[ItemState], max_count: int = 4) -> Array[StringName]:
	var out: Array[StringName] = []
	for s in snapshots:
		if out.size() >= max_count:
			break
		if not out.has(s.def_id):
			out.append(s.def_id)
	return out


## Какие снимки Тиран сбрасывает при переходе в фазу phase — как BossDirector._phase_items.
static func phase_dropped(phase: int, snapshots: Array[ItemState]) -> Array[ItemState]:
	var counts: PackedInt32Array = Db.balance.boss_phase_item_counts
	var out: Array[ItemState] = []
	if phase <= 0 or phase >= counts.size():
		return out
	for i in range(counts[phase], mini(counts[phase - 1], snapshots.size())):
		out.append(snapshots[i])
	return out
